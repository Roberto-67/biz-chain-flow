# Copy this file to .env and fill in the values, then restart the dev server.
# Never commit your real .env file.

# --- Database / auth (Lovable Cloud backend) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"

# --- Google Maps address lookup + Gmail order confirmations ---
# These run server-side through the Lovable connector gateway.
# Copy the values from your Lovable project settings (Secrets / Connectors).
LOVABLE_API_KEY="lov_xxxxxxxxxxxxxxxx"
GOOGLE_MAPS_API_KEY="xxxxxxxxxxxxxxxx"
GOOGLE_MAIL_API_KEY="xxxxxxxxxxxxxxxx"
